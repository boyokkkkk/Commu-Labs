function s1_noise_types(target_snr, impulse_prob, impulse_amp)
    %% s1: 探究四种通信信道模型对图像的破坏
    img_matrix = im2bw(imread('sysu_logo.bmp'), 0.5); 
    [img_height, img_width] = size(img_matrix);
    tx_bits = img_matrix(:)';
    num_bits = length(tx_bits);
    tx_symbols = 2 * tx_bits - 1;

    span = 6; sps = 8; alpha = 0.5;
    h_rrc = rcosdesign(alpha, span, sps, 'sqrt');
    tx_signal = upfirdn(tx_symbols, h_rrc, sps);

    
    % 信道 1：纯高斯白噪声 (AWGN）
    rx_signal_awgn = awgn(tx_signal, target_snr, 'measured');

    % 信道 2：AWGN + 突发脉冲噪声
    impulse_noise = (rand(size(tx_signal)) < impulse_prob) .* impulse_amp .* sign(randn(size(tx_signal)));
    rx_signal_burst = rx_signal_awgn + impulse_noise;

    % 信道 3：瑞利平坦衰落 + AWGN
    rayleigh_env = raylrnd(1, size(tx_signal)); 
    rx_signal_rayleigh = tx_signal .* rayleigh_env;
    rx_signal_rayleigh = awgn(rx_signal_rayleigh, target_snr, 'measured');
    
    % 信道 4：AWGN + 单频连续1波干扰
    t = 1:length(tx_signal);
    jamming_amp = 1.5; % 干扰信号强度
    jamming_signal = jamming_amp * cos(2 * pi * 0.15 * t); 
    rx_signal_jamming = rx_signal_awgn + jamming_signal;

    %% 接收端通用处理
    decode_signal = @(sig) upfirdn(sig, h_rrc, 1, sps);
    extract_bits = @(rx_sym) rx_sym(span + 1 : span + num_bits) > 0;

    % 计算 BER
    bits_awgn = extract_bits(decode_signal(rx_signal_awgn));
    ber_awgn = sum(tx_bits ~= bits_awgn) / num_bits;
    
    bits_burst = extract_bits(decode_signal(rx_signal_burst));
    ber_burst = sum(tx_bits ~= bits_burst) / num_bits;
    
    bits_rayleigh = extract_bits(decode_signal(rx_signal_rayleigh));
    ber_rayleigh = sum(tx_bits ~= bits_rayleigh) / num_bits;
    
    bits_jamming = extract_bits(decode_signal(rx_signal_jamming));
    ber_jamming = sum(tx_bits ~= bits_jamming) / num_bits;

    %% 绘图
    fig = figure('Visible', 'off', 'Position', [100, 100, 800, 800]);
    
    subplot(2,2,1); 
    imshow(reshape(bits_awgn, img_height, img_width)); 
    title(sprintf('純 AWGN \nBER = %.4f', ber_awgn), 'FontSize', 12);
    
    subplot(2,2,2); 
    imshow(reshape(bits_burst, img_height, img_width)); 
    title(sprintf('AWGN + 突发脉冲\nBER = %.4f', ber_burst), 'FontSize', 12);
    
    subplot(2,2,3); 
    imshow(reshape(bits_rayleigh, img_height, img_width)); 
    title(sprintf('瑞利衰落信道\nBER = %.4f', ber_rayleigh), 'FontSize', 12);
    
    subplot(2,2,4); 
    imshow(reshape(bits_jamming, img_height, img_width)); 
    title(sprintf('AWGN + 单频正弦干扰\nBER = %.4f', ber_jamming), 'FontSize', 12);

    % 自動保存
    if ~exist('result/B_s1', 'dir'), mkdir('result/B_s1'); end
    filename = sprintf('result_/SNR%d_Compare.png', target_snr);
    exportgraphics(fig, filename, 'Resolution', 300);
    close(fig);
end